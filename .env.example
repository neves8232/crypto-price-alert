# ================================
# Crypto Price Alert System - Environment Configuration
# ================================
#
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to version control
#
# Generate secure tokens with: openssl rand -hex 32
# ================================

# ================================
# APPLICATION ENVIRONMENT
# ================================
# Environment: development, staging, production
APP_ENV=production

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Enable Prometheus metrics collection
ENABLE_METRICS=true

# ================================
# TELEGRAM CONFIGURATION
# ================================
# Get your bot token from @BotFather on Telegram
# Format: 123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather

# Your Telegram chat ID (for receiving alerts)
# Get it from @userinfobot or @RawDataBot
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Telegram API Settings
TELEGRAM_API_TIMEOUT_SECONDS=30
TELEGRAM_RETRY_ATTEMPTS=3
TELEGRAM_RETRY_DELAY_SECONDS=2.0

# Rate Limiting (Telegram allows 30 msg/sec, we set 25 for safety)
RATE_LIMIT_MESSAGES_PER_SECOND=25.0
RATE_LIMIT_BURST_SIZE=50
QUEUE_MAX_SIZE=1000

# ================================
# SERVICE AUTHENTICATION
# ================================
# Shared secret token for service-to-service communication
# MUST be at least 32 characters
# Generate with: openssl rand -hex 32
AUTH_TOKEN=your_secure_random_token_here_minimum_32_characters

# ================================
# DATABASE CONFIGURATION
# ================================
# PostgreSQL Settings (Production)
POSTGRES_USER=crypto_user
POSTGRES_PASSWORD=secure_password_here_change_in_production
POSTGRES_DB=crypto_alerts

# Database Connection URL
# For PostgreSQL (production):
DATABASE_URL=postgresql+asyncpg://crypto_user:secure_password_here_change_in_production@postgres:5432/crypto_alerts

# For SQLite (development):
# DATABASE_URL=sqlite+aiosqlite:///./data/crypto_alerts.db

# ================================
# EXTERNAL API CONFIGURATION
# ================================
# CoinGecko API Provider
CRYPTO_API_PROVIDER=coingecko

# CoinGecko API Key (Optional - for higher rate limits)
# Free tier works without API key but has lower limits
# Get API key from: https://www.coingecko.com/en/api/pricing
COINGECKO_API_KEY=

# ================================
# PRICE MONITORING SETTINGS
# ================================
# How often to fetch cryptocurrency prices (in seconds)
CRYPTO_POLL_INTERVAL_SECONDS=15
POLL_INTERVAL_SECONDS=15

# Maximum number of cryptocurrencies to monitor simultaneously
MAX_WATCHLIST_SIZE=25

# ================================
# ALERT CONFIGURATION
# ================================
# Minimum time between triggering the same alert (in seconds)
ALERT_DEBOUNCE_SECONDS=30

# Maximum number of alerts to process in a batch
ALERT_BATCH_SIZE=10

# ================================
# SERVICE INTEGRATION
# ================================
# Telegram Service URL (internal Docker network)
TELEGRAM_SERVICE_URL=http://telegram-service:52001

# Timeout for Telegram service requests
TELEGRAM_SERVICE_TIMEOUT_SECONDS=10

# ================================
# SECURITY SETTINGS
# ================================
# CORS allowed origins (comma-separated)
# For production: specify exact origins
# For development: use "*" for all origins
CORS_ORIGINS=http://localhost:3000,http://localhost:52000

# ================================
# MONITORING (Optional)
# ================================
# Grafana admin credentials
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=secure_grafana_password_here

# ================================
# ADVANCED SETTINGS (Optional)
# ================================
# Service ports (usually don't need to change)
SERVICE_PORT=52000
API_PORT=52000
API_HOST=0.0.0.0

# ================================
# DEVELOPMENT OVERRIDES
# ================================
# Uncomment these for development with SQLite instead of PostgreSQL
# APP_ENV=development
# LOG_LEVEL=DEBUG
# DATABASE_URL=sqlite+aiosqlite:///./data/crypto_alerts.db
# CRYPTO_POLL_INTERVAL_SECONDS=30
# ALERT_DEBOUNCE_SECONDS=10

# ================================
# NOTES
# ================================
# 1. Required fields (MUST be set):
#    - TELEGRAM_BOT_TOKEN
#    - AUTH_TOKEN
#    - POSTGRES_PASSWORD (for production)
#
# 2. Security best practices:
#    - Use strong passwords (minimum 16 characters)
#    - Generate random tokens with: openssl rand -hex 32
#    - Never commit .env file to git
#    - Rotate secrets regularly
#
# 3. Getting Started:
#    - Copy this file: cp .env.example .env
#    - Fill in required values
#    - Run: make dev (development) or make prod (production)
#
# 4. For more information:
#    - See: docs/deployment/DOCKER_GUIDE.md
#    - Telegram Bot Setup: docs/setup/TELEGRAM_SETUP.md
# ================================
