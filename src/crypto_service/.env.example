# Crypto Price Alert Service - Environment Configuration
# Copy this file to .env and fill in your values

# Application Settings
APP_NAME=crypto-price-alert
APP_ENV=development  # development, staging, production
LOG_LEVEL=INFO       # DEBUG, INFO, WARNING, ERROR

# Web Server
API_HOST=0.0.0.0
API_PORT=52000
SERVICE_PORT=52000

# Database Configuration
# Development (SQLite)
DATABASE_URL=sqlite+aiosqlite:///./crypto_alerts.db

# Production (PostgreSQL)
# DATABASE_URL=postgresql+asyncpg://crypto_user:your_password@postgres:5432/crypto_alerts

# Crypto API Settings
CRYPTO_API_PROVIDER=coingecko
COINGECKO_API_KEY=  # Optional - for higher rate limits
CRYPTO_POLL_INTERVAL_SECONDS=15
POLL_INTERVAL_SECONDS=15
MAX_WATCHLIST_SIZE=25

# Alert Settings
ALERT_DEBOUNCE_SECONDS=30
ALERT_BATCH_SIZE=10

# Telegram Service Integration
TELEGRAM_SERVICE_URL=http://telegram-alert-service:52001
TELEGRAM_SERVICE_AUTH_TOKEN=  # Required - use: openssl rand -hex 32
AUTH_TOKEN=  # Alias for TELEGRAM_SERVICE_AUTH_TOKEN
TELEGRAM_SERVICE_TIMEOUT_SECONDS=10

# Security
INTERNAL_AUTH_TOKEN=  # Optional - use: openssl rand -hex 32
CORS_ORIGINS=http://localhost:3000,http://localhost:52000

# Observability
ENABLE_METRICS=true
METRICS_PORT=52002
