# Telegram Alert Service - Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# REQUIRED CONFIGURATION
# =============================================================================

# Telegram Bot Token (get from @BotFather on Telegram)
# Format: 123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Authentication Token for inter-service communication
# Generate with: openssl rand -hex 32
# MUST match the token used by the crypto-price-alert service
AUTH_TOKEN=your_secure_auth_token_here

# =============================================================================
# OPTIONAL CONFIGURATION
# =============================================================================

# Application Environment
# Options: development, staging, production
APP_ENV=development

# Logging Level
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Service Port
SERVICE_PORT=52001

# Service Host (0.0.0.0 for Docker, 127.0.0.1 for local)
HOST=0.0.0.0

# =============================================================================
# TELEGRAM API CONFIGURATION
# =============================================================================

# Telegram API request timeout in seconds
TELEGRAM_API_TIMEOUT_SECONDS=30

# Maximum retry attempts for failed Telegram API requests
TELEGRAM_RETRY_ATTEMPTS=3

# Initial retry delay in seconds (uses exponential backoff)
TELEGRAM_RETRY_DELAY_SECONDS=2.0

# =============================================================================
# RATE LIMITING
# =============================================================================

# Messages per second (Telegram limit is 30, we use 25 for safety)
RATE_LIMIT_MESSAGES_PER_SECOND=25.0

# Burst capacity (allows temporary bursts above rate limit)
RATE_LIMIT_BURST_SIZE=50

# =============================================================================
# MESSAGE QUEUE
# =============================================================================

# Maximum number of messages in queue
QUEUE_MAX_SIZE=1000

# =============================================================================
# OBSERVABILITY
# =============================================================================

# Enable Prometheus metrics
ENABLE_METRICS=true

# =============================================================================
# EXAMPLE PRODUCTION VALUES
# =============================================================================

# Production example (commented out):
# APP_ENV=production
# LOG_LEVEL=INFO
# TELEGRAM_API_TIMEOUT_SECONDS=30
# RATE_LIMIT_MESSAGES_PER_SECOND=25.0
# RATE_LIMIT_BURST_SIZE=50
# QUEUE_MAX_SIZE=1000
